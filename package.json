{
  "name": "reelqueue",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant SaaS for bulk Instagram Reels scheduling via official Meta APIs",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:core": "pnpm --filter @reelqueue/core test",
    "typecheck:core": "pnpm --filter @reelqueue/core typecheck",
    "db:verify": "./scripts/verify-db.sh",
    "test": "pnpm test:libs",
    "typecheck": "pnpm typecheck:libs",
    "build:libs": "pnpm -r --filter @reelqueue/core --filter @reelqueue/shared --filter @reelqueue/db --filter @reelqueue/services --filter @reelqueue/integrations --filter @reelqueue/http --filter @reelqueue/runtime --filter @reelqueue/worker build",
    "test:libs": "pnpm -r --filter @reelqueue/core --filter @reelqueue/integrations --filter @reelqueue/db --filter @reelqueue/services --filter @reelqueue/http --filter @reelqueue/runtime --filter @reelqueue/worker --workspace-concurrency=1 test",
    "typecheck:libs": "pnpm -r --filter @reelqueue/core --filter @reelqueue/shared --filter @reelqueue/integrations --filter @reelqueue/db --filter @reelqueue/services --filter @reelqueue/http --filter @reelqueue/runtime --filter @reelqueue/worker typecheck"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
