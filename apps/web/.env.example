# Browser-visible API origin (cookies are sent with credentials: 'include').
# Build-time value: it is inlined into the client bundle and into the CSP connect-src.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Origin(s) of the object storage that serves presigned PUT/GET URLs (R2 / MinIO / S3).
# Comma-separated list. Used ONLY for the CSP (connect-src for direct uploads, img-src/media-src for previews).
# Build-time. Example for local MinIO: http://localhost:9000
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000

# Base URL used by Playwright (e2e) - the full stack (API + worker in mock mode) must already be running.
E2E_BASE_URL=http://localhost:3000
