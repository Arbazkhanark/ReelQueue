# ReelQueue environment. Copy to .env and fill in. NEVER commit .env.
# All values below are safe PLACEHOLDERS, not real credentials.

# --- General -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Public origin of the web app and of the API (used for CORS, cookies, OAuth redirect)
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Cookie domain: leave empty locally; in production use a parent domain shared by web+api (e.g. .example.com)
COOKIE_DOMAIN=

# --- Runtime variables read by packages/runtime/src/config.ts (see that file for the full list) ---
# Comma-separated EXACT origins (no path, no trailing slash); https required in production
APP_ORIGINS=http://localhost:3000
PORT=4000
MIGRATE_ON_BOOT=true
# Meta mode only: no defaults on purpose (never assume a Graph version; confirm in Meta's docs)
META_GRAPH_BASE_URL=
META_GRAPH_VERSION=

# --- PostgreSQL / Redis -------------------------------------------------------
DATABASE_URL=postgres://reelqueue:reelqueue@localhost:5432/reelqueue
# Redis MUST use maxmemory-policy noeviction (BullMQ requirement) and ideally AOF persistence
REDIS_URL=redis://localhost:6379

# --- Auth ---------------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
OAUTH_STATE_SECRET=change-me-generate-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ALLOW_REGISTRATION=true

# --- Token encryption at rest (AES-256-GCM key ring) ---------------------------
# Format: "<keyId>:<base64 of 32 random bytes>[,<keyId>:<base64>...]"
# Generate a key: openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
TOKEN_ENCRYPTION_ACTIVE_KEY_ID=k1

# --- Instagram ----------------------------------------------------------------
# mock = nothing is ever published to Instagram (UI shows a MOCK banner). meta = real Meta API.
INSTAGRAM_PROVIDER=mock
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/v1/instagram/callback
# Confirm the exact scope strings in your Meta app dashboard (see docs/INSTAGRAM_SETUP.md)
META_SCOPES=instagram_business_basic,instagram_business_content_publish
# Keep this many publishes of headroom below Instagram's reported quota
QUOTA_RESERVE=0

# --- Object storage (Cloudflare R2 by default; any S3-compatible store works) ---
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=reelqueue-videos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Lifetime of the presigned URL handed to Meta; must exceed container processing + polling time
MEDIA_FETCH_URL_TTL_SECONDS=3600
UPLOAD_URL_TTL_SECONDS=3600

# --- Upload limits (defaults per user; overridable per user in the DB) ---------
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
MAX_UPLOAD_BATCH_FILES=200
# ASSUMPTIONS, not verified Meta requirements (see docs/INSTAGRAM_SETUP.md "Unverified"). Meta's container
# status ERROR is authoritative; tune these once you have confirmed the current spec.
MEDIA_ALLOWED_CONTENT_TYPES=video/mp4,video/quicktime
MEDIA_MAX_FILE_BYTES=1073741824
MEDIA_MIN_DURATION_SECONDS=3
MEDIA_MAX_DURATION_SECONDS=900

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_ID=
SWEEPER_INTERVAL_SECONDS=30
JOB_LEASE_SECONDS=300

# --- Email (verification / password reset), sent with Nodemailer --------------
# Setting EMAIL_HOST turns on real mail. Leave all EMAIL_* empty in development to print links to the API log instead.
# Gmail: use an App Password (https://myaccount.google.com/apppasswords), never your normal password. 465 + EMAIL_SECURE=true = implicit TLS;
# 587 + EMAIL_SECURE=false = STARTTLS. (SMTP_HOST/SMTP_PORT/SMTP_SECURITY/SMTP_USER/SMTP_PASS/MAIL_FROM are accepted as alternative names.)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ReelQueue <no-reply@example.com>
# Exact origin of the web app (mail links and OAuth redirect target); defaults to the first APP_ORIGINS entry
WEB_BASE_URL=http://localhost:3000

# --- Retention / housekeeping (worker) ----------------------------------------
RETENTION_VIDEO_DAYS=30
RETENTION_ACCOUNT_GRACE_DAYS=14
RETENTION_INTERVAL_MS=3600000

# --- Monitoring hooks (optional) ----------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=true







# --- Google Drive Storage -------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/v1/google-drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# --- Google Drive (OPTIONAL additional storage integration; leave empty to disable) ---------
# Setting any GOOGLE_DRIVE_* value requires all three. Placeholders only: never commit real values, never use NEXT_PUBLIC_*.
# The redirect URI must match the Google Cloud Console entry EXACTLY and end with /v1/google-drive/callback.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/v1/google-drive/callback
# Only drive.file is accepted (files ReelQueue creates itself). Broader scopes are refused by config validation.
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file


EMBEDDED_WORKER=true